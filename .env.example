# Copy to .env (never commit). Only OPENCODE_API_KEY is required.
# OpenCode Console API key — https://opencode.ai/console
OPENCODE_API_KEY=

# Jev / systemone endpoint (default shown)
# OPENCODE_DECIDE_BASE_URL=https://opencode.ai/inference/systemone
# Pinned model id (default shown). "jev-1.13-free" is free.
# OPENCODE_DECIDE_MODEL=jev-1.13-free

# Enable the built-ins-in-Code-Mode transform (default: off)
# OPENCODE_DECIDE_BUILTINS_CODEMODE=0
# OPENCODE_DECIDE_BUILTIN_IDS=read,grep,glob,shell,edit,write

# Inject the session-context hint (default: on)
# OPENCODE_DECIDE_HINT=1

# Explicit env file to read instead of <project>/.env or ~/.config/opencode/.env
# OPENCODE_DECIDE_ENV_FILE=
# Disable the auth.json dev fallback (default: allowed)
# OPENCODE_DECIDE_ALLOW_AUTH_JSON=1
